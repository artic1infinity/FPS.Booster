--> Handlers por ClassName (lookup O(1) em vez de cadeia de IsA)
local SmoothPlastic = Enum.Material.SmoothPlastic
local Performance = Enum.RenderFidelity.Performance
local KeepMaterial = {
	[Enum.Material.Neon] = true,
	[Enum.Material.Glass] = true,
	[Enum.Material.ForceField] = true,
}

local function shade(part)
	if Settings.Texture then
		local material = part.Material
		if material ~= SmoothPlastic and not KeepMaterial[material] then
			part.Material = SmoothPlastic
		end
		if part.Reflectance ~= 0 then
			part.Reflectance = 0
		end
		if part.MaterialVariant ~= "" then
			part.MaterialVariant = ""
		end
	end
end

local function onPart(part)
	if not isMine(part) then
		shade(part)
	end
end

local function onMesh(part)
	if isMine(part) then
		return
	end
	shade(part)
	if Settings.Meshes and part.RenderFidelity ~= Performance then
		part.RenderFidelity = Performance
	end
	if Settings.Aggressive and part.ClassName == "MeshPart" and part.TextureID ~= "" then
		part.TextureID = ""
	end
end

local function onDecal(decal)
	local parent = decal.Parent
	if parent and parent.Name == "Head" then
		return -- preserva rostos
	end
	if Settings.Aggressive then
		decal:Destroy()
	elseif decal.Transparency ~= 1 then
		decal.Transparency = 1
	end
end

local function onSurfaceAppearance(object) object:Destroy() end

local function onSky(sky)
	sky.StarCount = 0
	sky.CelestialBodiesShown = false
end

local function onAtmosphere(atmosphere)
	atmosphere.Density = 0
	atmosphere.Offset = 0
	atmosphere.Glare = 0
	atmosphere.Haze = 0
end

local function disable(object)
	if object.Enabled then
		object.Enabled = false
	end
end

local function hideExplosion(explosion)
	explosion.Visible = false
end

local Handlers = {}

if Settings.Texture then
	for _, className in ipairs({
		"Part", "WedgePart", "CornerWedgePart", "TrussPart",
		"Seat", "VehicleSeat", "SpawnLocation",
	}) do
		Handlers[className] = onPart
	end
	Handlers.SurfaceAppearance = onSurfaceAppearance
	Handlers.Decal = onDecal
	Handlers.Texture = onDecal
	Handlers.Sky = onSky
end

if Settings.Texture or Settings.Meshes then
	Handlers.MeshPart = onMesh
	Handlers.UnionOperation = onMesh
end

if Settings.Lighting then
	Handlers.Atmosphere = onAtmosphere
	Handlers.BloomEffect = disable
	Handlers.BlurEffect = disable
	Handlers.DepthOfFieldEffect = disable
	Handlers.SunRaysEffect = disable
	-- ColorCorrectionEffect e barato e altera muito as cores: mantido ligado.
end

if Settings.Terrain then
	Handlers.Clouds = disable
end

if Settings.Effects then
	for _, className in ipairs({
		"ParticleEmitter", "Trail", "Beam", "Fire", "Smoke", "Sparkles",
		"Highlight", "PointLight", "SpotLight", "SurfaceLight",
	}) do
		Handlers[className] = disable
	end
	Handlers.Explosion = hideExplosion
end

--> Fila para objetos novos (processados em lote, dentro do orcamento)
local queue, head, tail = {}, 1, 0
local running = false

local function pump()
	if running then
		return
	end
	running = true
	task.defer(function()
		while head <= tail do
			local started = os.clock()
			while head <= tail and os.clock() - started < BUDGET do
				local object = queue[head]
				queue[head] = nil
				head = head + 1
				if object.Parent then
					local handler = Handlers[object.ClassName]
					if handler then
						pcall(handler, object)
					end
				end
			end
			if head <= tail then
				RunService.Heartbeat:Wait()
			end
		end
		head, tail = 1, 0
		running = false
	end)
end

local function onAdded(object)
	if Handlers[object.ClassName] then
		tail = tail + 1
		queue[tail] = object
		pump()
	end
end

--> Varredura inicial (somente workspace e Lighting, fatiada por tempo)
local function scan(root)
	local list = root:GetDescendants()
	local started = os.clock()
	for index = 1, #list do
		local object = list[index]
		local handler = Handlers[object.ClassName]
		if handler then
			pcall(handler, object)
		end
		if index % 200 == 0 and os.clock() - started > BUDGET then
			RunService.Heartbeat:Wait()
			started = os.clock()
		end
	end
end

-- Conecta antes de varrer para nao perder objetos criados durante a varredura
workspace.DescendantAdded:Connect(onAdded)
Lighting.DescendantAdded:Connect(onAdded)

task.spawn(function()
	scan(Lighting)
	scan(workspace)
end)
