local sethiddenproperty = sethiddenproperty or set_hidden_property or set_hidden_prop

--> Orcamento de tempo por frame (menor no mobile)
local IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local BUDGET = IsMobile and 0.0015 or 0.003

--> Helpers
local function setHidden(instance, property, value)
	if sethiddenproperty then
		pcall(sethiddenproperty, instance, property, value)
	end
end

local function isMine(object)
	local character = Player and Player.Character
	return character ~= nil and object:IsDescendantOf(character)
end

--> Contador de FPS (opcional, leve: 1 conexao, texto atualizado 1x por segundo)
local function startCounter()
	local gui = Instance.new("ScreenGui")
	gui.Name = "FPSCounter"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 999999

	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(1, 0)
	label.Position = UDim2.new(1, -8, 0, 4)
	label.Size = UDim2.fromOffset(100, 24)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 18
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "FPS: --"
	label.Parent = gui

	local mounted = pcall(function()
		gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
	end)
	if not mounted then
		local playerGui = Player and Player:FindFirstChildOfClass("PlayerGui")
		if not playerGui then
			gui:Destroy()
			return
		end
		gui.Parent = playerGui
	end

	local frames, last, shown = 0, os.clock(), -1
	RunService.Heartbeat:Connect(function()
		frames = frames + 1
		local now = os.clock()
		local elapsed = now - last
		if elapsed >= 1 then
			local fps = math.floor(frames / elapsed + 0.5)
			if fps ~= shown then
				shown = fps
				label.Text = "FPS: " .. fps
			end
			frames = 0
			last = now
		end
	end)
end

if Settings.FPSCounter then
	startCounter()
end

